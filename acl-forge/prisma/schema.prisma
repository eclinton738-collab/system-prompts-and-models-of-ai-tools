generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  projects      Project[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Project {
  id        String   @id @default(cuid())
  userId    String
  name      String
  style     String   @default("war-film")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  clips    Clip[]
  timeline TimelineTrack[]
  exports  Export[]
}

model Clip {
  id           String       @id @default(cuid())
  projectId    String
  originalName String
  s3Key        String
  thumbnailKey String?
  duration     Float        @default(0)
  size         BigInt       @default(0)
  mimeType     String
  resolution   String?
  uploadStatus UploadStatus @default(PENDING)
  waveformData Json?
  uploadId     String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  timelineClips TimelineClip[]
}

enum UploadStatus {
  PENDING
  UPLOADING
  PROCESSING
  READY
  FAILED
}

model TimelineTrack {
  id        String    @id @default(cuid())
  projectId String
  type      TrackType
  order     Int       @default(0)
  createdAt DateTime  @default(now())

  project Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  clips   TimelineClip[]
}

enum TrackType {
  VIDEO
  AUDIO
  VO
  FX
}

model TimelineClip {
  id        String   @id @default(cuid())
  trackId   String
  clipId    String
  startTime Float
  duration  Float
  trimIn    Float    @default(0)
  trimOut   Float    @default(0)
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  track TimelineTrack @relation(fields: [trackId], references: [id], onDelete: Cascade)
  clip  Clip          @relation(fields: [clipId], references: [id], onDelete: Cascade)
}

model Export {
  id         String       @id @default(cuid())
  projectId  String
  status     ExportStatus @default(PENDING)
  s3Key      String?
  format     String       @default("mp4")
  resolution String       @default("1080p")
  jobId      String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

enum ExportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}
