# ─── DATABASE ──────────────────────────────────────────────
# Provided by docker-compose (no changes needed)
DATABASE_URL="postgresql://forge:forgepass@localhost:5432/acl_forge"

# ─── AUTH ───────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-output-of-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# GitHub OAuth — https://github.com/settings/developers → New OAuth App
#   Homepage URL:       http://localhost:3000
#   Callback URL:       http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"

# ─── ANTHROPIC ──────────────────────────────────────────────
# Get from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY="sk-ant-..."

# ─── STORAGE (MinIO — provided by docker-compose) ───────────
# No changes needed for local dev
AWS_ACCESS_KEY_ID="minioadmin"
AWS_SECRET_ACCESS_KEY="minioadmin"
AWS_REGION="us-east-1"
S3_BUCKET="acl-forge-media"
S3_ENDPOINT="http://localhost:9000"

# ─── REDIS (provided by docker-compose) ─────────────────────
REDIS_URL="redis://localhost:6379"

# ─── APP ────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
