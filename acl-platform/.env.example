# Copy to .env and adjust. Never commit real credentials.
DATABASE_URL="postgresql://acl:acl_dev_password@localhost:5432/acl?schema=public"
# Public origin of the site, used for canonical URLs, sitemap and share links.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Payment provider: "mock" (default, no real charges). Real gateways plug in via src/server/integrations/payments.
PAYMENT_PROVIDER="mock"
