# HMAC secret used to sign QR payloads. MUST be set to a long random value in production.
QR_SIGNING_SECRET=change-me-to-a-long-random-string

# "demo" (default) pins the server clock to event night (26 Sep 2026, 7:42 PM WAT) so the
# dashboard shows a live event. Set to "real" to use the actual system clock.
ACL_CLOCK=demo

# PostgreSQL connection for the Prisma schema in prisma/schema.prisma (not used in demo mode).
DATABASE_URL=postgresql://acl:acl@localhost:5432/acl_event_os
